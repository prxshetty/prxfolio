# prxfolio — public config overrides
# Copy to .env.local to customize without editing code:
#   cp .env.example .env.local
#
# Everything here is PUBLIC (NEXT_PUBLIC_*) and safe to fork/share.
# Rich content (experience, projects, blogs, socials) lives in en/*.yaml
# and is compiled into src/data.ts — env vars below only override the rest.

# Drive VIEW link so the resume opens in a new tab (NOT the uc?export=download form)
NEXT_PUBLIC_CV_URL=https://drive.google.com/file/d/1r6v-fgqYMO6rhngdeFsQP3Gbrn0JECEL/view?usp=sharing

# GitHub username for the live contribution graph
NEXT_PUBLIC_GITHUB_USERNAME=prxshetty

# Canonical site URL (used for metadata when deploying)
NEXT_PUBLIC_SITE_URL=https://prxshetty.github.io/prxfolio
